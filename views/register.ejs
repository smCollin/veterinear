<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <form action="/register" method="POST">
            <h2>Eier</h2>
            <input type="text" name="navn" placeholder="Navn">
            <input type="email" name="epost" placeholder="Epost">
            <input type="number" name="telefon" placeholder="Telefon">
            <input type="text" name="adresse" placeholder="Adresse">

            <h2>Dyr</h2>
            <input type="text" name="dyrNavn" placeholder="Dyrets navn">
            <input type="text" name="art" placeholder="Art">
            <input type="text" name="rase" placeholder="Rase">
            <input type="number" name="alder" placeholder="Alder">

            <h2>Veterinær</h2>
            <input type="text" name="veteriNavn" placeholder="Navn">
            <input type="email" name="veteriEpost" placeholder="Epost">
            <input type="number" name="veteriTelefon" placeholder="Telefon">
            <input type="text" name="spesialisering" placeholder="Spesialisering">
        <button>Registrer</button>
    </form>
</body>
</html>